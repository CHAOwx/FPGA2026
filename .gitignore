# ========================================
# STM32 / Keil-MDK 工程临时文件和编译输出
# ========================================

# 编译产物（不需要提交）
*.axf
*.hex
*.elf
*.out
*.map
*.lst
*.sct
*.scr
*.htm
*.build_log.htm
*.uv4.log
*.uv4.log.lock

# 中间文件
*.o
*.obj
*.d
*.crf
*.dmp
*.lnp
*.iex

# Keil 工程临时/个性化配置
# 备份文件
*.bak            
# 依赖文件
*.dep          
# 用户环境配置（调试窗口布局等，因人而异）  
*.uvoptx         
# Keil GUI 配置文件（因人而异）
*.uvguix.*       

# ==========================
# IntelliJ IDEA / JetBrains
# ==========================

# IDEA 工程配置目录
/.idea/          
# 模块文件
*.iml            
# 工作区文件
*.iws            
# 默认编译输出目录
out/             

# =================
# VS Code
# =================
# VS Code 配置目录
.vscode/         
# VS Code 工作区文件
*.code-workspace 

# 可选：只保留部分配置（如要共享调试/编译配置）
# .vscode/*
# !.vscode/settings.json
# !.vscode/launch.json

# =================
# 通用系统垃圾文件
# =================
# macOS Finder 缓存
.DS_Store        
# Windows 缩略图缓存
Thumbs.db        
# 日志文件
*.log            
# 临时文件
*.tmp            

# =================
# 输出目录（可选）
# =================
# 常见构建目录
/build/          
# Keil/MDK Debug 输出
/Debug/          
# Keil/MDK Release 输出
/Release/        

# ========================================
# 建议提交的文件（不要忽略）
# ========================================
#   - 源码文件: *.c, *.h
#   - 启动文件: startup_xx.s
#   - 工程配置: *.uvprojx
#   - RTE 配置: *.rteconfig
#   - 链接文件: *.sct (如果团队共享)

# Keil 编译日志文件（全局忽略）
**/uv4.log
**/uv4.log.lock
**/Template.build_log.htm

# ========================================
# Latex(vscode编辑器)忽略配置
# ========================================

**/main.log
**/main.pdf
**/main.synctex.gz
**/main.aux

# === Vivado 工程共享与生成文件忽略规则 ===
# 提交 *.xpr 工程入口及 *.srcs/ 下的源码、约束、仿真和 IP 配置
# 提交 *.xci / *.xcix、*.bd、自定义 IP 的 component.xml 和初始化数据
# 队友安装兼容版本的 Vivado 后可直接打开 *.xpr，重新生成编译产物
# 仅忽略个人工程配置，不全局忽略 XML（自定义 IP 可能依赖它）
*.xpr.user
*.xml.user

# 缓存和运行目录（最大的垃圾制造者）
*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.runs/
.Xil/

# 日志和临时文件
*.jou
*.log
*.str
*.debug
*.backup*
*.tmp
*.bak

# IP 自动生成的输出（保留 IP 配置和自定义 IP 描述文件）
**/*.srcs/sources_1/ip/**/synth/
**/*.srcs/sources_1/ip/**/simulation/
**/*.srcs/sources_1/ip/**/sim_scripts/
**/*.srcs/sources_1/ip/**/example_design/
**/*.srcs/sources_1/ip/**/doc/
**/*.srcs/sources_1/ip/**/.upgrade_log
**/*.srcs/sources_1/ip/**/synth_*.log
**/*.srcs/sources_1/ip/**/sim_*.log

# Block Design：保留 *.bd、HDL wrapper 和内部 IP 配置，忽略界面状态
*.bd.user
**/*.srcs/sources_1/bd/**/ui/

# 导出文件（偶尔会有人误提交）
*.xsa
*.bit
*.bin
*.mcs
*.prm
*.dcp
*.rpt
# 不全局忽略 *.txt / *.csv：可能是 ROM 初始化或仿真输入数据

# Vivado Lab Edition / Vitis 相关
*.ltx
*.mmi
*.hbs
*.xpe
*.xpr.zip
*.zip

# 其他常见
*.gen/
*.tmp/
*.data/
*.webtalk/
webtalk_*.log
vivado*.backup.jou
vivado*.backup.log

